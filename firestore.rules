rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if authenticated user is registered administrator
    function isAdmin() {
      return request.auth != null && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email.matches('.*admin.*') ||
        request.auth.token.email == 'admin@labelhemareddy.com'
      );
    }

    // Admins registry: Read only by authenticated users, modify only by existing admin
    match /admins/{adminId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Products: Publicly readable; writable only by authenticated Admins
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Categories: Publicly readable; writable only by Admins
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Brand and Site Settings: Publicly readable; writable only by Admins
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders: Anyone can create an order; only admins can list/update/delete orders
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Custom Stitching Enquiries: Anyone can submit an enquiry; only admins can read and manage
    match /enquiries/{enquiryId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Contact Messages: Anyone can submit; only admins can read and manage
    match /messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Registered user profiles
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }
  }
}
