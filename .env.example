# ====================================================================
# OWNER & ADMIN AUTHENTICATION
# ====================================================================
# Passwords in the backend database are cryptographically hashed using scrypt + 128-bit salt.
# Plaintext passwords are NEVER stored in the database, localStorage, or frontend code.
# You can set your business email and initial password below, or configure it anytime via CLI:
#   node server/setup-admin.js <business-email> <password>
ADMIN_EMAIL=contact@hemareddy.com
ADMIN_PASSWORD=hemareddy2026
VITE_ADMIN_EMAIL=contact@hemareddy.com

# ====================================================================
# PERMANENT CLOUD STORAGE & IMAGE CDN (CLOUDINARY)
# ====================================================================
# 100% Free Forever (25 GB storage & 25 GB bandwidth)
# Get credentials at: https://cloudinary.com/users/register_free
# You can also enter these directly in Admin > Website Settings > Cloud Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Alternative Free Cloud Provider (ImgBB)
IMGBB_API_KEY=
