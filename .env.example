# Firebase Configuration
# IMPORTANT: In this Vite project, variables MUST be prefixed with VITE_ (e.g. VITE_FIREBASE_API_KEY)
# Obtain these values from Firebase Console > Project Settings > General > Your apps > SDK setup:
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-app.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ====================================================================
# OWNER & ADMIN AUTHENTICATION
# ====================================================================
# Passwords in the backend database are cryptographically hashed using scrypt + 128-bit salt.
# Plaintext passwords are NEVER stored in the database, localStorage, or frontend code.
ADMIN_EMAIL=labelhemareddy@gmail.com
ADMIN_PASSWORD=hemareddy2026
VITE_ADMIN_EMAIL=labelhemareddy@gmail.com

# ====================================================================
# PERMANENT CLOUD STORAGE & IMAGE CDN (CLOUDINARY)
# ====================================================================
# 100% Free Forever (25 GB storage & 25 GB bandwidth)
# Get credentials at: https://cloudinary.com/users/register_free
# You can also enter these directly in Admin > Website Settings > Cloud Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
